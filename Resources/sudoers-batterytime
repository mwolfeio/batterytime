# Installed by BatteryTime's install-sudoers.sh. Lets __USER__ switch the energy mode
# (Automatic / Low Power / High Power, battery or power adapter) without a password, and nothing else.
__USER__ ALL=(root) NOPASSWD: /usr/bin/pmset -b powermode 0, /usr/bin/pmset -b powermode 1, /usr/bin/pmset -b powermode 2, /usr/bin/pmset -c powermode 0, /usr/bin/pmset -c powermode 1, /usr/bin/pmset -c powermode 2
